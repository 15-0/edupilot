# PostgreSQL connection string (Neon / Supabase / Render). Leave unset to use local SQLite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enables AI answers in document chat + AI revision topics
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# "hashing" (default, no download) or "fastembed" (pip install fastembed; better semantic search)
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384
